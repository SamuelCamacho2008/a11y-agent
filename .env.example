# ==============================================================================
# A11y Agent - Variables de Entorno de Configuración
# ==============================================================================

# Entorno general
ENV=development
DEBUG=false

# Crawler y Seguridad de Red
USER_AGENT=A11yAgent/1.0 (+https://github.com/a11y-agent/bot; accessibility evaluation bot)
REQUEST_TIMEOUT=30
MAX_PAGE_SIZE_BYTES=15728640
RESPECT_ROBOTS_TXT=true
ALLOW_PRIVATE_IPS=false

# Proveedor de LLM (auto | openai | anthropic | gemini | mock)
# 'auto': detecta automáticamente la clave presente. Si no hay clave, usa el motor heurístico determinista.
LLM_PROVIDER=auto
LLM_MODEL=

# Claves de API de los Proveedores (Completar según el proveedor seleccionado)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
